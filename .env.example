# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.

# Form kontak: daftar gratis di https://formspree.io, buat form baru, lalu salin ID-nya
# (bagian akhir dari https://formspree.io/f/XXXXXXXX). Kosong = form memakai mailto sebagai cadangan.
NEXT_PUBLIC_FORMSPREE_ID=

# Alamat website. Kosong = otomatis memakai alamat Vercel.
NEXT_PUBLIC_SITE_URL=
